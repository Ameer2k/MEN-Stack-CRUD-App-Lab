<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= novel.name %></title>
</head>
<body>
    <%- include('./partials/navbar') %>
    <h1><%= novel.name %></h1>
    <p><%= novel.description %></p>
    <p>Publication year: <%= novel.poplishYear %></p>
    <p>Genres: <%= (novel.gere || []).join(', ') %></p>

    <% if (novel.image) { %>
        <img src="<%= novel.image %>" alt="<%= novel.name %>">
    <% } %>

    <a href="/novels/<%= novel._id %>/edit">Edit</a>
    <a href="/novels">All Novels</a>
    <form action="/novels/<%= novel._id %>?_method=DELETE" method="post">
        <button>Delete</button>
    </form>
</body>
</html>

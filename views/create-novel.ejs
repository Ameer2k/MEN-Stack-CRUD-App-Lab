<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Create a Novel</title>
  </head>
  <body>
    <%- include('./partials/navbar') %>
    <h1>Create a Novel</h1>

    <form action="/novels" method="post">
      <label for="name">Name:</label>
      <input name="name" id="name" type="text" />

      <label for="description">Description:</label>
      <textarea name="description" id="description"></textarea>

      <label for="poplishYear">Publication year:</label>
      <input name="poplishYear" id="poplishYear" type="number" />

      <label for="gere">Genres (comma separated):</label>
      <input name="gere" id="gere" type="text" />

      <label for="image">Image URL:</label>
      <input name="image" id="image" type="url" />

      <button>Create Novel</button>
    </form>
  </body>
</html>

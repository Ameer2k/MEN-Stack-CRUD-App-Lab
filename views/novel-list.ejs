<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Novels</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('./partials/navbar') %>
    <main>
        <h1>All Novels</h1>
        <a class="button" href="/novels/new">Create new Novel</a>

        <% if(novels.length === 0){ %>
            <p>No entries yet. Create your first entry above.</p>
        <% } %>

        <% for(let oneNovel of novels){ %>
            <article>
                <h2>Name: <%= oneNovel.name %></h2>
                <p><%= oneNovel.description %></p>
                <a href="/novels/<%= oneNovel._id %>">See Novel Details</a>
            </article>
        <% } %>
    </main>
</body>
</html>

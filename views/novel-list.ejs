<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>All Novels</title>
</head>
<body>
    <%- include('./partials/navbar') %>
    <h1>All Novels</h1>
    <a href="/novels/new">Create a Novel</a>

    <% for (const novel of novels) { %>
        <h2><%= novel.name %></h2>
        <p><%= novel.description %></p>
        <a href="/novels/<%= novel._id %>">View Novel</a>
    <% } %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Novel</title>
</head>
<body>
    <%- include('./partials/navbar') %>
    <h1>Edit Novel</h1>
    <form action="/novels/<%= novel._id %>?_method=PUT" method="post">
        <label for="name">Name:</label>
        <input name="name" id="name" type="text" value="<%= novel.name %>" required>

        <label for="description">Description:</label>
        <textarea name="description" id="description" required><%= novel.description %></textarea>

        <label for="poplishYear">Publication year:</label>
        <input name="poplishYear" id="poplishYear" type="number" value="<%= novel.poplishYear %>" required>

        <label for="gere">Genres (comma separated):</label>
        <input name="gere" id="gere" type="text" value="<%= novel.gere.join(', ') %>">

        <label for="image">Image URL:</label>
        <input name="image" id="image" type="url" value="<%= novel.image %>">

        <button>Save Novel</button>
    </form>
</body>
</html>
